{
  "_schema": "evidence-ledger-template-v1.1",
  "_description": "Machine-readable four-track evidence ledger schema. One entry per ingredient per formula. All tracks must be executed even if no evidence is found. v1.1 adds citation-level integrity fields per reference/citation_integrity_contract.md: whitelisted sources only, no locator no citation, standard format, absent is valid, fabrication prohibited.",

  "_allowed_values": {
    "evidence_status": ["supported", "weak", "absent", "conflicting", "animal_only", "traditional_only", "mechanistic_only"],
    "study_type": ["meta_analysis", "systematic_review", "large_rct", "small_rct", "controlled_trial", "case_report", "none_found"],
    "verification_status": ["verified", "partially_verified", "unverified", "rejected"],
    "locator_type": ["pmid", "doi", "nct", "cochrane_id", "cnki_url", "cbm_id"],
    "live_retrieval_performed": [true, false],
    "tcm_t1_status": ["traditional_record_only"],
    "tcm_t2_status": ["pharmacopeial_standard"],
    "tcm_t3_status": ["supported", "weak", "absent", "conflicting", "none_found"],
    "mechanism_is_not_efficacy_proof": [true]
  },

  "_citation_required_fields": [
    "title",
    "authors",
    "journal",
    "year",
    "volume_pages",
    "study_type",
    "source_id",
    "locator_type",
    "locator_value",
    "locator_url",
    "retrieved_at",
    "verification_status",
    "verification_method"
  ],

  "_required_ingredient_fields": [
    "ingredient_name",
    "dose_in_formula",
    "track_1_human_clinical",
    "track_2_animal",
    "track_3_tcm_material",
    "track_4_mechanistic_safety",
    "overall_evidence_status"
  ],

  "formula_metadata": {
    "formula_id": "",
    "search_date": "",
    "search_sources_summary": []
  },

  "ingredients": [
    {
      "ingredient_name": "",
      "dose_in_formula": "",
      "track_1_human_clinical": {
        "search_sources": [],
        "evidence_found": false,
        "study_type": "none_found",
        "study_details": "",
        "study_limitations": "",
        "evidence_status": "absent",
        "source_locator": "",
        "citations": [
          {
            "title": "",
            "authors": "",
            "journal": "",
